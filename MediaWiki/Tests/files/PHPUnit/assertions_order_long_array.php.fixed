<?php

// phpcs:disable Generic.Arrays.DisallowLongArraySyntax

class AssertionsOrderLongArrayTest extends \PHPUnit\Framework\TestCase {
	/** @coversNothing */
	public function testAssertions() {
		// Should be replaced, the long array() syntax is handled like [] (T336420)
		$this->assertSame( array(), $emptyArray );
		$this->assertSame( array( 1, 2, 3 ), $intArray );
		$this->assertSame( array( 'something' => 'other' ), $result, 'Message' );
		$this->assertSame( array( 'key' => $expectedValue ), $resultWithValue, 'Message' );
		$this->assertSame( array( array( 1, 2 ), 3 ), $nestedArray, 'Message' );
		$this->assertSame(
			array(
				'first' => 'a',
				'second' => $expected,
				'nested' => array( true, false ),
				500
			),
			$bigArray,
			'Message'
		);

		// Should not be replaced
		$this->assertSame( array( 1, 2 ), $actual );
		$this->assertSame( $var, array( 'a', $actual ) );
		$this->assertSame( $var, array( 'a', getValue() ), 'Message' );
	}
}
